# Build output
build/

# vcpkg packages
vcpkg_installed/
vcpkg/

# Model files (large, downloaded separately — see scripts/download_models.ps1)
# All ONNX models are excluded from the repo; the installer bundles them from
# local disk via embed.FS, so a fresh clone needs to fetch them before building.
*.onnx
models/*.dat
models/*.bz2
*.onnx

# IDE / VS
.vs/
*.user
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
CMakeCache.txt
CMakeFiles/

# Log files
*.log

# Local PAD calibration output (biometric-derived scores; never commit)
pad-calibration/

# Binary artifacts
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.bmp

# Node (root — only used by scripts/)
node_modules/
package-lock.json

# Python cache
__pycache__/

# Claude Code 本地会话目录（AGENTS.md/CLAUDE.md 守则入口随仓库公开）
.claude/

# Wails
installer/FaceLoginSetup/build/
installer/FaceLoginSetup/frontend/node_modules/
installer/FaceLoginSetup/frontend/dist/
# wailsjs Go↔JS bindings are regenerated by `wails build`/`wails dev`
# (file headers: "automatically generated. DO NOT EDIT"). Tracking them only
# creates noise on every build.
installer/FaceLoginSetup/frontend/wailsjs/
# wails writes this md5 to decide whether to regenerate bindings; build artifact.
installer/FaceLoginSetup/frontend/package.json.md5

# Node
node_modules/

# OS
Thumbs.db
.DS_Store

# Star history data (workflow-generated, lives on star-history branch)
.star-history-data/

