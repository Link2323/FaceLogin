// VERSIONINFO resource — filled by CMake's configure_file() from the root
// project() version via facelogin_add_version_rc(). This is the only place
// file/product versions get stamped into CMake-built binaries; bumping the
// version is done in CMakeLists.txt project(), never in this file.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @RC_FILEVERSION@
 PRODUCTVERSION @RC_FILEVERSION@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       @RC_FILETYPE@
 FILESUBTYPE    0x0L
 BEGIN
     BLOCK "StringFileInfo"
     BEGIN
         BLOCK "040904b0"
         BEGIN
             VALUE "CompanyName",      "FaceLogin"
             VALUE "FileDescription",  "@RC_FILEDESCRIPTION@"
             VALUE "FileVersion",      "@RC_FILEVERSION_STR@"
             VALUE "InternalName",     "@RC_INTERNALNAME@"
             VALUE "OriginalFilename", "@RC_ORIGINALFILENAME@"
             VALUE "ProductName",      "FaceLogin"
             VALUE "ProductVersion",   "@RC_FILEVERSION_STR@"
         END
     END
     BLOCK "VarFileInfo"
     BEGIN
         VALUE "Translation", 0x409, 1200
     END
 END
